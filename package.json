{
  "name": "gul-sons-shop-manager",
  "version": "1.0.1",
  "description": "Gul Son's — Shop Management Desktop Application for Clothes & Perfume",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/run-all.js",
    "build-icon": "node build-icon.js",
    "build": "node build-icon.js && electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "author": "Gul Son's",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "call-bind-apply-helpers": "^1.0.2",
    "exceljs": "^4.4.0",
    "jsbarcode": "^3.11.6",
    "pdfkit": "^0.15.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.33.2"
  },
  "build": {
    "appId": "com.gulsons.shopmanager",
    "productName": "Gul Sons Shop Manager",
    "copyright": "Copyright © 2026 Gul Son's Clothing & Perfume",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "!node_modules/*/{test,__tests__,tests,example,examples,docs,.*}",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/sharp/**",
      "!node_modules/png-to-ico/**",
      "!node_modules/@img/**",
      "!node_modules/7zip-bin/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/call-bind-apply-helpers",
        "to": "app/node_modules/call-bind-apply-helpers"
      },
      {
        "from": "renderer/assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gul Sons Shop Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
